# Copie este arquivo para .env.local para desenvolvimento na sua máquina.
# Em produção (GitHub Pages), essas variáveis vêm das Secrets do repositório
# e são injetadas durante o build pelo GitHub Actions (.github/workflows/deploy.yml).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Nome do repositório no GitHub (usado no basePath para GitHub Pages).
# Se o repo se chamar "kayg-cpa", deixe como está.
NEXT_PUBLIC_BASE_PATH=/kayg-cpa
